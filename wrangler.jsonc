{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odeh-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Built by `next build` (output: "export").
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Pages are served straight from the static files (free and unlimited);
    // only the contact form API runs the Worker.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Where contact form inquiries are emailed. RESEND_API_KEY is a secret set
  // in the Cloudflare dashboard, never in this file.
  "vars": {
    "NOTIFY_EMAIL": "Admin@omarodehcpa.com"
  }
}
