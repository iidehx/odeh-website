# Required for the contact form to email new inquiries (without it, submissions
# are still saved but no email is sent). Sign up free at https://resend.com,
# verify the account with Odeh90@gmail.com, then create an API key and paste it
# below (locally) or add it as an environment variable in Vercel project settings.
RESEND_API_KEY=

# Optional overrides — safe to leave unset, these default to the values below.
# NOTIFY_EMAIL=Odeh90@gmail.com
# RESEND_FROM_EMAIL=Omar Odeh CPA Website <onboarding@resend.dev>

# Used to build absolute URLs in metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.omarodehcpa.com
