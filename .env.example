# Contact form email (Resend). Without RESEND_API_KEY the form tells visitors
# to call or email instead, because inquiries are only delivered by email.
#
# Production: add these in the Cloudflare dashboard under Workers & Pages >
# omarodehcpa > Settings > Variables and Secrets (RESEND_API_KEY as a Secret).
# Local testing with `npm run preview`: copy them into a file named .dev.vars.
#
# With the default onboarding@resend.dev sender, Resend only delivers to the
# email that owns the Resend account, so sign up with Odeh90@gmail.com.
RESEND_API_KEY=

# Optional overrides; these default to the values below.
# NOTIFY_EMAIL=Odeh90@gmail.com
# RESEND_FROM_EMAIL=Omar Odeh CPA Website <onboarding@resend.dev>

# Build time: absolute URLs in metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.omarodehcpa.com
